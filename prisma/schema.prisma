// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Mirrors the signed-in user from Clerk (see src/lib/clerk-sync.ts).
// Clerk is the source of truth for auth; this row lets other tables
// (and app data) reference a user via a normal foreign key.
model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  imageUrl  String?
  // Used by the study session sizer to compute "weeks since semester
  // start" for Claude. Optional — the sizer still works without it.
  semesterStartDate DateTime?
  // Opt-out for the daily procrastination-nudge cron job (see
  // src/lib/procrastination-nudge-job.ts). A dedicated field per
  // notification type rather than one generic flag/JSON blob, so a future
  // second notification type (e.g. an exam-plan digest) can be muted
  // independently.
  procrastinationNudgesEnabled Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  integrations Integration[]
  assignments  Assignment[]
  officeHours  OfficeHours[]
  studySessions StudySession[]
  examPlans    ExamPlan[]
  procrastinationNudges ProcrastinationNudge[]
}

// A single app-wide row (not per-user) for the Google OAuth client this
// app instance registered with Google — analogous to Clerk's keys, not a
// personal credential like the per-user rows on Integration. Lives in
// Postgres instead of env vars so it's editable from Settings without a
// server restart. See src/lib/google-calendar.ts (createOAuth2Client).
model AppConfig {
  id                         String   @id @default("singleton")
  googleCalendarClientId     String?
  googleCalendarClientSecret String?
  googleCalendarRedirectUri  String?
  updatedAt                  DateTime @updatedAt
}

enum IntegrationProvider {
  GOOGLE_CALENDAR
  CANVAS
  NOTION
  ANTHROPIC
}

// Tracks per-user connection status/credentials for the third-party
// integrations wired up in the sidebar. Tokens would be populated once
// each provider's OAuth/API-key flow is implemented.
model Integration {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    IntegrationProvider
  accessToken String?
  refreshToken String?
  metadata    Json?
  connectedAt DateTime?
  // Set on connect (the connect flow already verifies the credential) and
  // refreshed by POST /api/settings/check-connections, which re-tests each
  // provider live rather than trying to read an expiration date — Notion
  // tokens don't expire, Canvas personal access tokens don't expose their
  // expiry via the API, and Google's refresh token has no fixed lifetime
  // (it lasts until revoked or unused for 6 months). "Still works as of
  // this check" is the honest thing to show instead.
  lastVerifiedAt DateTime?
  lastVerifiedOk Boolean?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([userId, provider])
}

enum AssignmentType {
  EXAM
  PAPER
  HOMEWORK
  PROJECT
}

// Extracted from an uploaded syllabus PDF (see src/app/api/syllabus/*) and
// reviewed/edited by the user before being confirmed and saved here.
model Assignment {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  // Free text rather than DateTime: syllabus due dates are often irregular
  // ("Week 5 Friday", "TBD") and the review step lets the user fix these.
  dueDate   String?
  weight    Float?
  type      AssignmentType
  // Set by the study session sizer (src/lib/study-sizer.ts): the final,
  // user-adjusted hours estimate, and the linked Canvas course (so the
  // module topics don't need to be re-selected on a later re-estimate).
  estimatedHours  Float?
  canvasCourseId  String?
  // Free-text course label (e.g. "CS 101") set once at syllabus-upload time
  // (src/components/dashboard/syllabus-uploader.tsx) — used to match an
  // assignment to office hours for the same course (src/lib/office-hours-matcher.ts).
  course    String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  studySessions StudySession[]
  examPlan      ExamPlan?
  procrastinationNudges ProcrastinationNudge[]

  @@index([userId])
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// Professor/TA office hours, either imported from a Canvas course's
// syllabus text (src/lib/office-hours-extractor.ts) or entered manually.
model OfficeHours {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          String
  instructorName  String
  instructorEmail String?
  dayOfWeek       DayOfWeek
  // "HH:MM", 24-hour — there's no dedicated Time scalar in Prisma/Postgres
  // here, and these are never date-arithmetic'd directly (see
  // office-hours-matcher.ts for how a concrete next occurrence is derived).
  startTime String
  endTime   String
  // Physical room or a Zoom/Meet link — same free-text field either way.
  location  String
  // "canvas" or "manual", so imported rows can be told apart from
  // hand-entered ones if that's ever useful.
  source    String    @default("manual")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

enum StudySessionStatus {
  SCHEDULED
  PROGRESS_MADE
  BLOCKED
}

// One row per session written to Google Calendar by backward planning
// (src/app/api/planning/commit/route.ts). The stuck detector
// (src/lib/stuck-detector.ts) reads these to notice when a student marked
// a session blocked, or let a scheduled session pass with no check-in.
model StudySession {
  id             String             @id @default(cuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignmentId   String
  assignment     Assignment         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  scheduledStart DateTime
  scheduledEnd   DateTime
  status         StudySessionStatus @default(SCHEDULED)
  blockedNote    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([userId])
  @@index([assignmentId])
}

// Generated once per exam assignment by the daily background job
// (src/lib/exam-plan-job.ts, run via GET /api/cron/exam-plans) the first
// time that exam falls within 7 days — never regenerated after that, so a
// student's checked-off topics (ExamPlanTopic.completed) aren't lost.
// Relational rather than a JSON blob so a single topic can be toggled by
// ID and "remaining coverage" recomputed without a read-modify-write of
// the whole plan.
model ExamPlan {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignmentId String       @unique
  assignment   Assignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  days         ExamPlanDay[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([userId])
  @@map("exam_plans")
}

model ExamPlanDay {
  id                      String         @id @default(cuid())
  examPlanId              String
  examPlan                ExamPlan       @relation(fields: [examPlanId], references: [id], onDelete: Cascade)
  date                    String // "YYYY-MM-DD"
  estimatedDurationMinutes Int
  topics                  ExamPlanTopic[]
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  @@index([examPlanId])
  @@map("exam_plan_days")
}

model ExamPlanTopic {
  id            String      @id @default(cuid())
  examPlanDayId String
  examPlanDay   ExamPlanDay @relation(fields: [examPlanDayId], references: [id], onDelete: Cascade)
  topic         String
  completed     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([examPlanDayId])
  @@map("exam_plan_topics")
}

// One row per nudge actually sent by the daily procrastination-detection job
// (src/lib/procrastination-nudge-job.ts, run via GET
// /api/cron/procrastination-nudge). Keeping history (rather than a single
// `lastNudgedAt` on Assignment) is what lets the job enforce "don't nudge
// the same assignment more than once every 48 hours" with a simple
// most-recent-row-per-assignment query.
model ProcrastinationNudge {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  message      String
  createdAt    DateTime   @default(now())

  @@index([userId])
  @@index([assignmentId])
  @@map("procrastination_nudges")
}
