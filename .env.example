# Copy this file to .env and fill in real values.
# .env is already git-ignored — never commit real secrets.

# ---------------------------------------------------------------------------
# Database (Postgres, via Prisma)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"

# ---------------------------------------------------------------------------
# Clerk (authentication) — https://dashboard.clerk.com
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where Clerk's prebuilt components live / redirect to. These are picked up
# automatically by @clerk/nextjs.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ---------------------------------------------------------------------------
# Google Calendar API — https://console.cloud.google.com
# ---------------------------------------------------------------------------
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/integrations/google-calendar/callback

# ---------------------------------------------------------------------------
# Canvas LMS API — Account > Settings > New Access Token, on your Canvas instance
# ---------------------------------------------------------------------------
CANVAS_API_URL=https://your-school.instructure.com
CANVAS_API_KEY=

# ---------------------------------------------------------------------------
# Anthropic API — https://console.anthropic.com
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Notion API — https://www.notion.so/my-integrations
# ---------------------------------------------------------------------------
NOTION_API_KEY=
NOTION_DATABASE_ID=
