# Copy this file to .env and fill in real values.
# .env is already git-ignored — never commit real secrets.

# ---------------------------------------------------------------------------
# Database (Postgres, via Prisma)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"

# ---------------------------------------------------------------------------
# Clerk (authentication) — https://dashboard.clerk.com
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where Clerk's prebuilt components live / redirect to. These are picked up
# automatically by @clerk/nextjs.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ---------------------------------------------------------------------------
# Google Calendar API — https://console.cloud.google.com
# ---------------------------------------------------------------------------
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/integrations/google-calendar/callback

# ---------------------------------------------------------------------------
# Canvas LMS — no env vars needed. Each user connects their own Canvas URL
# and personal access token from the Courses page in the dashboard
# (Account > Settings > New Access Token, on their Canvas instance) — see
# src/lib/canvas.ts. Credentials are stored per-user on the Integration
# table, not globally, since different users attend different schools.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Anthropic API — no env var needed. Each user connects their own API key
# on the Settings page — see src/lib/anthropic.ts. Credentials are stored
# per-user on the Integration table, not globally, so nobody spends the app
# owner's credits.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# PDF extractor microservice (services/pdf-extractor) — used by the syllabus
# upload feature to pull text out of an uploaded PDF before it goes to Claude
# ---------------------------------------------------------------------------
PDF_EXTRACTOR_URL=http://localhost:8000
# Optional: must match PDF_EXTRACTOR_SHARED_SECRET in the microservice's own
# environment. Leave both unset for local dev.
PDF_EXTRACTOR_SHARED_SECRET=

# ---------------------------------------------------------------------------
# Notion API — no env var needed. Each user connects their own integration
# token + database ID on the Notes page — see src/lib/notion.ts. Same
# per-user pattern as Canvas and Anthropic above.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Exam plan cron (GET /api/cron/exam-plans) — shared secret so the daily job
# can be triggered by an external scheduler (Vercel Cron, launchd, GitHub
# Actions) without a signed-in Clerk session. Sent as
# `Authorization: Bearer <CRON_SECRET>` (or `?secret=` for manual/local
# triggering). See src/lib/exam-plan-job.ts.
# ---------------------------------------------------------------------------
CRON_SECRET=
